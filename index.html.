<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>سیستم پرونده پزشکی</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 20px;
            font-family: Tahoma, Arial, sans-serif;
            background: #f2f5f8;
            color: #222;
        }

        .container {
            max-width: 600px;
            margin: auto;
        }

        .header {
            background: white;
            padding: 22px;
            border-radius: 18px;
            text-align: center;
            margin-bottom: 18px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.08);
        }

        .header h1 {
            margin: 0 0 8px;
            font-size: 25px;
        }

        .header p {
            margin: 0;
            color: #777;
        }

        .card {
            background: white;
            padding: 20px;
            border-radius: 18px;
            margin-bottom: 18px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.08);
        }

        .card h2 {
            margin-top: 0;
            font-size: 20px;
        }

        label {
            display: block;
            margin-top: 13px;
            margin-bottom: 6px;
            font-weight: bold;
        }

        input,
        select {
            width: 100%;
            padding: 13px;
            border: 1px solid #ccd2d8;
            border-radius: 10px;
            font-size: 16px;
            font-family: inherit;
            background: white;
        }

        input:focus,
        select:focus {
            outline: none;
            border-color: #555;
        }

        button {
            width: 100%;
            padding: 14px;
            margin-top: 18px;
            border: none;
            border-radius: 10px;
            font-size: 17px;
            font-family: inherit;
            cursor: pointer;
        }

        .save-btn {
            background: #222;
            color: white;
        }

        .search-btn {
            background: #e9edf1;
            color: #222;
        }

        .clear-btn {
            background: #eee;
            color: #333;
        }

        .patient {
            border: 1px solid #ddd;
            border-radius: 12px;
            padding: 15px;
            margin-top: 12px;
            background: #fafafa;
        }

        .patient h3 {
            margin-top: 0;
        }

        .patient p {
            margin: 8px 0;
        }

        .delete-btn {
            background: #ddd;
            color: #222;
            margin-top: 10px;
        }

        .message {
            text-align: center;
            margin-top: 12px;
            font-weight: bold;
        }

        .empty {
            text-align: center;
            color: #777;
            padding: 15px;
        }
    </style>
</head>

<body>

<div class="container">

    <div class="header">
        <h1>🏥 سیستم پرونده پزشکی</h1>
        <p>ثبت و مدیریت اطلاعات بیماران</p>
    </div>


    <!-- فرم ثبت بیمار -->
    <div class="card">

        <h2>ثبت بیمار جدید</h2>

        <label>نام و نام خانوادگی</label>
        <input
            id="name"
            type="text"
            placeholder="مثلاً نرگس کیانی"
        >

        <label>کد ملی</label>
        <input
            id="nationalCode"
            type="text"
            inputmode="numeric"
            maxlength="10"
            placeholder="کد ملی"
        >

        <label>شماره پرونده</label>
        <input
            id="fileNumber"
            type="text"
            placeholder="شماره پرونده"
        >

        <label>نام پدر</label>
        <input
            id="fatherName"
            type="text"
            placeholder="نام پدر"
        >

        <label>آدرس</label>
        <input
            id="address"
            type="text"
            placeholder="آدرس بیمار"
        >

        <label>نوع بیمه</label>
        <select id="insurance">
            <option value="">انتخاب نوع بیمه</option>
            <option>تأمین اجتماعی</option>
            <option>بیمه سلامت</option>
            <option>نیروهای مسلح</option>
            <option>بیمه آزاد</option>
            <option>سایر</option>
        </select>

        <label>شماره تماس</label>
        <input
            id="phone"
            type="tel"
            inputmode="tel"
            placeholder="شماره تماس"
        >

        <button class="save-btn" onclick="savePatient()">
            ثبت بیمار
        </button>

        <div id="message" class="message"></div>

    </div>


    <!-- جست‌وجوی بیماران -->
    <div class="card">

        <h2>جست‌وجوی بیمار</h2>

        <input
            id="search"
            type="text"
            placeholder="نام، کد ملی یا شماره پرونده"
            oninput="searchPatients()"
        >

        <button class="clear-btn" onclick="showAllPatients()">
            نمایش همه بیماران
        </button>

    </div>


    <!-- لیست بیماران -->
    <div class="card">

        <h2>لیست بیماران</h2>

        <div id="patientsList"></div>

    </div>

</div>


<script>

    // گرفتن اطلاعات ذخیره شده
    function getPatients() {

        return JSON.parse(
            localStorage.getItem("medicalPatients") || "[]"
        );

    }


    // ذخیره اطلاعات
    function savePatient() {

        const name =
            document.getElementById("name").value.trim();

        const nationalCode =
            document.getElementById("nationalCode").value.trim();

        const fileNumber =
            document.getElementById("fileNumber").value.trim();

        const fatherName =
            document.getElementById("fatherName").value.trim();

        const address =
            document.getElementById("address").value.trim();

        const insurance =
            document.getElementById("insurance").value;

        const phone =
            document.getElementById("phone").value.trim();


        // بررسی نام
        if (name === "") {

            showMessage(
                "لطفاً نام و نام خانوادگی را وارد کنید."
            );

            return;

        }


        // ساخت پرونده
        const patient = {

            id: Date.now(),

            name: name,

            nationalCode: nationalCode,

            fileNumber: fileNumber,

            fatherName: fatherName,

            address: address,

            insurance: insurance,

            phone: phone

        };


        // گرفتن بیماران قبلی
        const patients = getPatients();


        // اضافه کردن بیمار جدید
        patients.push(patient);


        // ذخیره در گوشی
        localStorage.setItem(
            "medicalPatients",
            JSON.stringify(patients)
        );


        // پاک کردن فرم
        document.getElementById("name").value = "";
        document.getElementById("nationalCode").value = "";
        document.getElementById("fileNumber").value = "";
        document.getElementById("fatherName").value = "";
        document.getElementById("address").value = "";
        document.getElementById("insurance").value = "";
        document.getElementById("phone").value = "";


        showMessage(
            "✅ بیمار با موفقیت ثبت شد."
        );


        // نمایش لیست
        showAllPatients();

    }


    // نمایش پیام
    function showMessage(text) {

        const message =
            document.getElementById("message");

        message.textContent = text;

        setTimeout(function() {

            message.textContent = "";

        }, 3000);

    }


    // نمایش همه بیماران
    function showAllPatients() {

        const patients = getPatients();

        displayPatients(patients);

    }


    // جست‌وجوی بیمار
    function searchPatients() {

        const search =
            document
                .getElementById("search")
                .value
                .trim()
                .toLowerCase();


        const patients = getPatients();


        if (search === "") {

            displayPatients(patients);

            return;

        }


        const results = patients.filter(function(patient) {

            return (

                patient.name.toLowerCase().includes(search)

                ||

                patient.nationalCode
                    .toLowerCase()
                    .includes(search)

                ||

                patient.fileNumber
                    .toLowerCase()
                    .includes(search)

            );

        });


        displayPatients(results);

    }


    // نمایش بیماران روی صفحه
    function displayPatients(patients) {

        const list =
            document.getElementById("patientsList");


        list.innerHTML = "";


        if (patients.length === 0) {

            list.innerHTML =
                '<div class="empty">هنوز بیماری ثبت نشده است.</div>';

            return;

        }


        patients.forEach(function(patient) {

            const div =
                document.createElement("div");

            div.className = "patient";


            div.innerHTML = `

                <h3>👤 ${escapeHTML(patient.name)}</h3>

                <p>
                    <strong>کد ملی:</strong>
                    ${escapeHTML(patient.nationalCode)}
                </p>

                <p>
                    <strong>شماره پرونده:</strong>
                    ${escapeHTML(patient.fileNumber)}
                </p>

                <p>
                    <strong>نام پدر:</strong>
                    ${escapeHTML(patient.fatherName)}
                </p>

                <p>
                    <strong>آدرس:</strong>
                    ${escapeHTML(patient.address)}
                </p>

                <p>
                    <strong>نوع بیمه:</strong>
                    ${escapeHTML(patient.insurance)}
                </p>

                <p>
                    <strong>شماره تماس:</strong>
                    ${escapeHTML(patient.phone)}
                </p>

                <button
                    class="delete-btn"
                    onclick="deletePatient(${patient.id})"
                >
                    حذف پرونده
                </button>

            `;


            list.appendChild(div);

        });

    }


    // حذف بیمار
    function deletePatient(id) {

        const patients = getPatients();


        const newPatients =
            patients.filter(function(patient) {

                return patient.id !== id;

            });


        localStorage.setItem(
            "medicalPatients",
            JSON.stringify(newPatients)
        );


        showAllPatients();

    }


    // جلوگیری از نمایش کد HTML داخل اطلاعات بیمار
    function escapeHTML(text) {

        return String(text || "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");

    }


    // نمایش اولیه
    showAllPatients();

</script>

</body>
</html>